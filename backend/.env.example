# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret

# Database (SQLite for development)
DATABASE_URL=sqlite:///saferoute.db

# CORS – frontend Vite default port
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Anomaly / safety thresholds (used from Phase 8+)
LOCATION_INTERVAL_SEC=5
STOP_THRESHOLD_SEC=150
DEVIATION_THRESHOLD_M=100
LOST_SIGNAL_SEC=75
SAFETY_RESPONSE_SEC=40
SOS_COUNTDOWN_SEC=20

# Demo mode allows simulated anomalies without real danger
DEMO_MODE=true

# Frontend URL used in share links for trusted contacts
FRONTEND_URL=http://127.0.0.1:5173


# Mapbox Access Token (Geocoding & Maps)
MAPBOX_ACCESS_TOKEN=

# Meta WhatsApp Cloud API (Automatic SOS & Emergency WhatsApp)
# Get from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional pre-approved template name (e.g. hello_world or custom sos_alert)
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
SEND_WHATSAPP_ON_JOURNEY_START=false

# Set true to demo poor-network store-and-forward path
SIMULATE_POOR_NETWORK=false

