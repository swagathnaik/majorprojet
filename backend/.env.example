# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-another-long-random-secret

# Database (SQLite for development)
DATABASE_URL=sqlite:///saferoute.db

# CORS – frontend Vite default port
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Anomaly / safety thresholds (used from Phase 8+)
LOCATION_INTERVAL_SEC=5
STOP_THRESHOLD_SEC=150
DEVIATION_THRESHOLD_M=100
LOST_SIGNAL_SEC=75
SAFETY_RESPONSE_SEC=40
SOS_COUNTDOWN_SEC=20

# Demo mode allows simulated anomalies without real danger
DEMO_MODE=true

# Frontend URL used in share links for trusted contacts
FRONTEND_URL=http://127.0.0.1:5173

# Optional email notify (leave blank for demo log-only)
# NOTIFY_SMTP_HOST=
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_SMTP_FROM=
# NOTIFY_EMAIL_TO=

# Set true to demo poor-network store-and-forward path
SIMULATE_POOR_NETWORK=false
